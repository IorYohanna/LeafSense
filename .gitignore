# ============================================
.DS_Store
Thumbs.db
*.log
.env
.env.local
.env.*.local

# ============================================
# BACKEND — Spring Boot / Maven / Java
# ============================================
Backend/target/
Backend/.mvn/wrapper/maven-wrapper.jar
Backend/*.class
Backend/*.jar
Backend/*.war
Backend/HELP.md
Backend/.classpath
Backend/.project
Backend/.settings/
Backend/bin/

# IDE Java
Backend/.idea/
Backend/*.iml
Backend/.vscode/

# ============================================
