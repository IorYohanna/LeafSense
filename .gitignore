# ============================================
Frontend/node_modules/
Frontend/.expo/
Frontend/dist/
Frontend/web-build/
Frontend/expo-env.d.ts

# Native build folders (générés par prebuild, ne jamais commiter)
Frontend/android/
Frontend/ios/

# Cache Metro / Babel
Frontend/node_modules/
Frontend/node_modules/.cache/
Frontend/.metro-cache/

# EAS
Frontend/.easrc

# Logs npm/yarn
Frontend/npm-debug.*
Frontend/yarn-debug.*
Frontend/yarn-error.*
Frontend/.pnpm-debug.log*

# ============================================
# IDE / ÉDITEURS (racine du projet)
# ============================================
.vscode/
.idea/
*.swp
*.swo

# ============================================
# SECRETS — ne jamais commiter
# ============================================
**/application-local.properties
**/*.keystore
**/*.jks
Frontend/google-services.json
Frontend/GoogleService-Info.plist


