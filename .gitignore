# ============================================
# GÉNÉRAL / OS
# ============================================
.DS_Store
Thumbs.db
*.log
.env
.env.local
.env.*.local

# ============================================
# BACKEND — Spring Boot / Maven / Java
# ============================================
Backend/target/
Backend/.mvn/wrapper/maven-wrapper.jar
Backend/*.class
Backend/*.jar
Backend/*.war
Backend/HELP.md
Backend/.classpath
Backend/.project
Backend/.settings/
Backend/bin/

# IDE Java
Backend/.idea/
Backend/*.iml
Backend/.vscode/

# ============================================
# FRONTEND — Expo / React Native / Node
# ============================================
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# Native build folders (générés par prebuild, ne jamais commiter)
frontend/android/
frontend/ios/

# Cache Metro / Babel
frontend/node_modules/.cache/
frontend/.metro-cache/

# EAS
frontend/.easrc

# Logs npm/yarn
frontend/npm-debug.*
frontend/yarn-debug.*
frontend/yarn-error.*
frontend/.pnpm-debug.log*

# ============================================
# IDE / ÉDITEURS (racine du projet)
# ============================================
.vscode/
.idea/
*.swp
*.swo

# ============================================
# SECRETS — ne jamais commiter
# ============================================
**/application-local.properties
**/*.keystore
**/*.jks
frontend/google-services.json
frontend/GoogleService-Info.plist