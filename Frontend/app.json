{
  "expo": {
    "name": "Plant Scanner",
    "slug": "plant-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.plantapp.plantscanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plantapp.plantscanner",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin de la caméra pour identifier vos plantes."
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "L'application a besoin de la caméra pour identifier vos plantes.",
          "enableCodeScanner": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {}
    }
  }
}
